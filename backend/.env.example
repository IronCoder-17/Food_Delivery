# Copy this file to .env and fill in your real values.

SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# ---- Google Sign-In (customer login) ----
# Must be the SAME Client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
# Get it from Google Cloud Console -> APIs & Services -> Credentials.
# See GOOGLE_LOGIN_SETUP.md at the project root for full setup steps.
# Never share the Client Secret with the frontend -- this app only needs
# the Client ID (a public value) to verify tokens server-side.
GOOGLE_CLIENT_ID= Your Google Clinet ID
# ---- MySQL connection (your real database) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Your Database Password
DB_NAME=food_delivery

# ---- Razorpay (get these from your Razorpay dashboard) ----
RAZORPAY_KEY_ID= 
RAZORPAY_KEY_SECRET= 

# ---- Misc ----
DELIVERY_FEE=40
OTP_DEBUG_MODE=1
FLASK_DEBUG=1
PORT=5000

# ---- AI Assistant (customer-side) ----
# Uses OpenRouter's free tier by default (OpenAI-compatible /chat/completions).
# Get a free key at https://openrouter.ai -- no credit card required.
# AI_MODEL=openrouter/free uses OpenRouter's auto-router, which picks a
# currently-available free model for you. Specific ":free" model IDs
# (e.g. meta-llama/llama-3.3-70b-instruct:free) get rotated out often --
# if one starts returning 404, either swap to a current one from
# https://openrouter.ai/models?fmt=cards&max_price=0 or switch back to
# openrouter/free.
# Never expose this key to the frontend -- it is only ever read on the backend.
AI_API_KEY= 
AI_MODEL=
AI_BASE_URL=
