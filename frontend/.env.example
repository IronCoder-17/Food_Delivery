# Copy this file to .env and fill in your real values.

VITE_API_BASE=http://localhost:5000/api

# ---- Google Sign-In (customer login) ----
# Get this from Google Cloud Console -> APIs & Services -> Credentials.
# It's a public value (safe to ship in frontend code) -- never put the
# Client Secret here or anywhere in the frontend.
# See GOOGLE_LOGIN_SETUP.md at the project root for full setup steps.
# Leave blank to keep the "Continue with Google" button hidden.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
